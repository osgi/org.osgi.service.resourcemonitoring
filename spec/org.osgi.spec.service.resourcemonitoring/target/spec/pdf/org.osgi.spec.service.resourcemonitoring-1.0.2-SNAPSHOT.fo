                     <fo:list-item>
                        <fo:list-item-label end-indent="label-end()">
                           <fo:block text-align="end">[1]</fo:block>
                        </fo:list-item-label>
                        <fo:list-item-body start-indent="body-start()">
                           <fo:block id="service.resourcemonitoring_bibliomixed_id_20150105_11h45_1">
                              <fo:inline font-style="italic">Adaptive
      Monitoring of End-user OSGi based Home Boxes</fo:inline>
                              <fo:block/>Y. Maurel, A.
      Bottaro, R. Kopetz, and K. Attouchi. Component Base Software
      Engineering, 15th ACM SIGSOFT International Symposium on Component-Based
      Software Engineering, CBSE'2012, Bertinoro, Italy, June
