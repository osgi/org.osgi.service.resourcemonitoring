                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>An array of {@link ResourceContext} objects, or an empty array,
         if no contexts have been created.</fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
                  </fo:block>
               </fo:block>
            </fo:block>
         </fo:block>
