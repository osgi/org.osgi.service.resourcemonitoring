                              </fo:block>
                           </fo:list-item-label>
                           <fo:list-item-body start-indent="body-start()">
                              <fo:block>
A ResourceContext rc1 is equals to ResourceContext rc2 if rc1.getName()
 is equals to rc2.getName().
   </fo:block>
                           </fo:list-item-body>
                        </fo:list-item>
                     </fo:list-block>
